{
    "name": "php-sso/php-sso",
    "description": "An OpenID Connect provider with SCIM provisioning and SAML sign-in, and an admin panel.",
    "keywords": [
        "sso",
        "single-sign-on",
        "openid-connect",
        "oidc",
        "oauth2",
        "scim",
        "saml",
        "identity-provider"
    ],
    "type": "project",
    "license": "MIT",
    "homepage": "https://github.com/php-sso/php-sso",
    "support": {
        "issues": "https://github.com/php-sso/php-sso/issues",
        "source": "https://github.com/php-sso/php-sso"
    },
    "require": {
        "php": "^8.3",
        "ext-openssl": "*",
        "ext-pdo_sqlite": "*",
        "laminas/laminas-diactoros": "^3.0",
        "laminas/laminas-httphandlerrunner": "^2.10",
        "php-sso/oauth-server": "^1.1.1",
        "php-sso/saml": "^1.1",
        "php-sso/scim-server": "^1.1",
        "psr/http-client": "^1.0",
        "twig/twig": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "PhpSso\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "suggest": {
        "ext-pdo_mysql": "To keep the data in MySQL 8.0.19 or later instead of SQLite",
        "ext-pdo_pgsql": "To keep the data in PostgreSQL 13 or later instead of SQLite"
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration"
    }
}
