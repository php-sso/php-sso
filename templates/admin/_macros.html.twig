{# Shared form pieces. Macros can't see the template context, so everything is passed in. #}
{% macro input(name, label, value, errors, type = 'text', hint = '', attrs = '') %}
<div class="field{{ errors[name] is defined ? ' has-error' }}">
  <label for="{{ name }}">{{ label }}</label>
  <input type="{{ type }}" id="{{ name }}" name="{{ name }}" value="{{ value }}" {{ attrs|raw }}>
  {% if hint %}<div class="hint">{{ hint }}</div>{% endif %}
  {% if errors[name] is defined %}<div class="err" role="alert">{{ errors[name] }}</div>{% endif %}
</div>
{% endmacro %}

{% macro error(errors, key) %}{% if errors[key] is defined %}<div class="err" role="alert">{{ errors[key] }}</div>{% endif %}{% endmacro %}

{# A POST button that asks for confirmation (in a dialog) before submitting. #}
{% macro confirm_button(action, csrf, label, title, message, class = 'btn danger') %}
<form method="post" action="{{ action }}">
  <input type="hidden" name="_csrf" value="{{ csrf }}">
  <button class="{{ class }}" data-confirm="{{ message }}" data-confirm-title="{{ title }}" data-confirm-label="{{ label }}">{{ label }}</button>
</form>
{% endmacro %}

{# One row of a checklist: a checkbox, the name, and what it means underneath. `field` is the form field it belongs to. #}
{% macro check_row(field, value, meaning, checked) %}
<label class="check-row"><input type="checkbox" name="{{ field }}[]" value="{{ value }}"{{ checked ? ' checked' }}><span class="check-text"><b class="mono">{{ value }}</b>{% if meaning %}<small>{{ meaning }}</small>{% endif %}</span></label>
{% endmacro %}

{# The search box above a list page: the text goes in `q`, and the page goes back to the first. #}
{% macro listbar(action, q, placeholder) %}
<form class="listbar" method="get" action="{{ action }}" role="search">
  <input type="search" name="q" value="{{ q }}" placeholder="{{ placeholder }}" aria-label="{{ placeholder }}" autocomplete="off">
  <button class="btn ghost">Search</button>
  {% if q %}<a class="btn ghost" href="{{ action }}">Clear</a>{% endif %}
</form>
{% endmacro %}

{# Under a list: how many there are (of what matches the search), and which page this is. #}
{% macro listfoot(pager, one, many) %}
<div class="listfoot"><span class="muted">{{ pager.total }} {{ pager.total == 1 ? one : many }}{% if pager.pages > 1 %}, page {{ pager.page }} of {{ pager.pages }}{% endif %}</span></div>
{% endmacro %}

{# A numbered pager for a PhpSso\Admin\Pager. `base` is the address up to and including `?` (and any other parameters, each followed by `&`). #}
{% macro pager(pager, base, param = 'page', anchor = '') %}
{% if pager.pages > 1 %}
<nav class="pager" aria-label="Pages">
  {% if pager.page > 1 %}<a href="{{ base }}{{ param }}={{ pager.page - 1 }}{{ anchor }}" rel="prev">Previous</a>{% else %}<span class="off">Previous</span>{% endif %}
  <ol>
    {% for n in pager.links %}
      {% if n is null %}<li class="gap" aria-hidden="true">...</li>
      {% elseif n == pager.page %}<li><span class="here" aria-current="page">{{ n }}</span></li>
      {% else %}<li><a href="{{ base }}{{ param }}={{ n }}{{ anchor }}" aria-label="Page {{ n }}">{{ n }}</a></li>{% endif %}
    {% endfor %}
  </ol>
  {% if pager.page < pager.pages %}<a href="{{ base }}{{ param }}={{ pager.page + 1 }}{{ anchor }}" rel="next">Next</a>{% else %}<span class="off">Next</span>{% endif %}
</nav>
{% endif %}
{% endmacro %}

{% macro avatar(name, size = '') %}<span class="avatar {{ size }}" style="--h: {{ hue(name) }}" aria-hidden="true">{{ initials(name) }}</span>{% endmacro %}

{% macro chip(name) %}<span class="chip" style="--h: {{ hue(name) }}">{{ name }}</span>{% endmacro %}
