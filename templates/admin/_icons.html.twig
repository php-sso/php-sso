{# Inline stroke icons, 24px grid. Decorative: always paired with text. #}
{% macro icon(name) %}
<svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
{%- if name == 'overview' %}<rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="4.5" rx="1.5"/><rect x="13" y="11" width="7" height="9" rx="1.5"/><rect x="4" y="14" width="7" height="6" rx="1.5"/>
{%- elseif name == 'users' %}<circle cx="9" cy="8" r="3.2"/><path d="M3 19c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5"/><path d="M16 5.2a3.2 3.2 0 0 1 0 5.6M18 14c1.8.7 3 2.4 3 5"/>
{%- elseif name == 'user' %}<circle cx="12" cy="8" r="3.6"/><path d="M5 20c0-3.9 3.1-6.5 7-6.5s7 2.6 7 6.5"/>
{%- elseif name == 'groups' %}<path d="m12 3.5-9 4.8 9 4.8 9-4.8-9-4.8Z"/><path d="m3 12.7 9 4.8 9-4.8M3 16.9l9 4.6 9-4.6"/>
{%- elseif name == 'dots' %}<circle cx="12" cy="5.5" r="1.6" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"/><circle cx="12" cy="18.5" r="1.6" fill="currentColor" stroke="none"/>
{%- elseif name == 'edit' %}<path d="M4 20h4L19 9a2.1 2.1 0 0 0-3-3L5 17v3Z"/><path d="m14.5 7.5 3 3"/>
{%- elseif name == 'trash' %}<path d="M5 7h14M10 7V4.5h4V7M7 7l.8 12.5h8.4L17 7M10.5 11v5M13.5 11v5"/>
{%- elseif name == 'scopes' %}<path d="M4 7h9M17 7h3M4 17h3M11 17h9"/><circle cx="15" cy="7" r="2"/><circle cx="9" cy="17" r="2"/>
{%- elseif name == 'roles' %}<path d="M12 3.5 5 6.2v5.1c0 4.1 2.8 7.2 7 9.2 4.2-2 7-5.1 7-9.2V6.2l-7-2.7Z"/><path d="m9 12 2.2 2.2L15.2 10"/>
{%- elseif name == 'clients' %}<rect x="3" y="4.5" width="18" height="15" rx="2.5"/><path d="M3 9.5h18M7 7h.01M10 7h.01"/>
{%- elseif name == 'shield' %}<path d="M12 3.5 5 6v5.5c0 4.2 2.9 7.5 7 9 4.1-1.5 7-4.8 7-9V6l-7-2.5Z"/><path d="m9 12 2 2 4-4"/>
{%- elseif name == 'history' %}<path d="M4 12a8 8 0 1 0 2.5-5.8"/><path d="M4 4.5V8h3.5"/><path d="M12 8v4.4l3 1.8"/>
{%- elseif name == 'flask' %}<path d="M9.5 4h5M10.5 4v5.2L5.3 18a2 2 0 0 0 1.7 3h10a2 2 0 0 0 1.7-3l-5.2-8.8V4"/><path d="M8 15h8"/>
{%- elseif name == 'plus' %}<path d="M12 5v14M5 12h14"/>
{%- elseif name == 'search' %}<circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/>
{%- elseif name == 'key' %}<circle cx="7.5" cy="12" r="4"/><path d="M11.5 12H21M17 12v3.5M20 12v2.5"/>
{%- elseif name == 'copy' %}<rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6.5A2.5 2.5 0 0 1 7.5 4H15"/>
{%- elseif name == 'logout' %}<path d="M10 5H6.5A2.5 2.5 0 0 0 4 7.5v9A2.5 2.5 0 0 0 6.5 19H10M15 8l4 4-4 4M19 12H9"/>
{%- elseif name == 'lock' %}<rect x="5" y="10.5" width="14" height="9.5" rx="2.2"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/>
{%- endif -%}
</svg>
{% endmacro %}
