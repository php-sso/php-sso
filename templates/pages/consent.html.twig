{% extends 'layout.html.twig' %}
{% block title %}{{ consent.name }}{% endblock %}
{% block page_name %}login{% endblock %}
{% block content %}
<section class="card narrow">
  <h1>{{ consent.name }}</h1>
  {% block intro %}{% if step.of > 1 %}<p class="muted">{{ step.of }} notices to accept before you continue.</p>{% endif %}{% endblock %}
  {% if consent.message %}<p class="consent-text">{{ consent.message|nl2br }}</p>{% endif %}
  {% if consent.url %}<p><a href="{{ consent.url }}" target="_blank" rel="noopener noreferrer">Read the full text</a></p>{% endif %}
  {% if error %}<div class="notice error" role="alert">{{ error }}</div>{% endif %}
  <form method="post" action="/login/required" novalidate>
    <input type="hidden" name="_csrf" value="{{ csrf }}">
    <input type="hidden" name="consent_id" value="{{ consent.id }}">
    <input type="hidden" name="version" value="{{ consent.version }}">
    <label class="consent-check"><input type="checkbox" name="accept" value="1" required> <span>I have read this and I accept it.</span></label>
    <button class="btn block">Continue</button>
  </form>
  {% block after_form %}<p class="muted"><a href="/login">Cancel</a></p>{% endblock %}
</section>
{% endblock %}
