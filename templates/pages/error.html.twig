{% extends 'layout.html.twig' %}
{% block title %}{{ title }}{% endblock %}
{% block page_name %}error{% endblock %}
{% block content %}
<section class="card narrow">
  <h1>{{ title }}</h1>
  <p>{{ message }}</p>
  {% if code is defined and code %}<p><small>Error code: <code>{{ code }}</code></small></p>{% endif %}
  <p><a class="btn ghost" href="/">Back to start</a></p>
</section>
{% endblock %}
