{% extends '_email.html.twig' %}
{% block email_body %}
<p style="margin:0 0 14px;">Hello {{ user.name }},</p>
<p style="margin:0 0 14px;">The password of your {{ app_name }} account (<strong>{{ user.username }}</strong>) was changed on {{ at }}, from {{ ip }}, using a link sent to this address. You were signed out everywhere.</p>
<p style="margin:0;">If this was you, there is nothing to do. If it was not, someone has access to your email: contact your administrator at once.</p>
{% endblock %}
