{% extends 'layout.html.twig' %}
{% import '_macros.html.twig' as f %}
{% block title %}Forgot your password{% endblock %}
{% block page_name %}login{% endblock %}
{% block content %}
<section class="card narrow">
  <h1>Forgot your password?</h1>
  {% if sent %}
    {% block sent %}<div class="notice success" role="status">If an account matches, we have sent an email with a link to choose a new password. The link works for {{ minutes }} minutes. Check your spam folder if it does not arrive.</div>{% endblock %}
    <p class="muted"><a href="/login">Back to sign in</a></p>
  {% else %}
    {% block intro %}<p class="muted">Enter your username or the email address of your account. If it matches, we send a link to choose a new password.</p>{% endblock %}
    {% if error %}<div class="notice error" role="alert">{{ error }}</div>{% endif %}
    <form method="post" action="/password/forgot" novalidate>
      <input type="hidden" name="_csrf" value="{{ csrf }}">
      {{ f.field('identifier', 'Username or email address', identifier, '', 'text', 'autocomplete="username" autofocus required') }}
      <button class="btn block">Send the link</button>
    </form>
    {% block after_form %}<p class="muted"><a href="/login">Back to sign in</a></p>{% endblock %}
  {% endif %}
</section>
{% endblock %}
