{% extends 'layout.html.twig' %}
{% import '_macros.html.twig' as f %}
{% block title %}Choose a new password{% endblock %}
{% block page_name %}login{% endblock %}
{% block content %}
<section class="card narrow">
  <h1>Choose a new password</h1>
  {% block intro %}<p class="muted">Before you continue, <strong>{{ username }}</strong>, choose a password of your own. Use at least {{ min_length }} characters.</p>{% endblock %}
  {% if error %}<div class="notice error" role="alert">{{ error }}</div>{% endif %}
  <form method="post" action="/login/required" novalidate>
    <input type="hidden" name="_csrf" value="{{ csrf }}">
    {{ f.field('new_password', 'New password', '', '', 'password', 'autocomplete="new-password" autofocus required') }}
    {{ f.field('confirm_password', 'Repeat the new password', '', '', 'password', 'autocomplete="new-password" required') }}
    <button class="btn block">Save and continue</button>
  </form>
  {% block after_form %}{% endblock %}
</section>
{% endblock %}
