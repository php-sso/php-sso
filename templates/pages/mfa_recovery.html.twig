{% extends 'layout.html.twig' %}
{% block title %}Recovery codes{% endblock %}
{% block page_name %}{{ user ? 'account' : 'login' }}{% endblock %}
{% block content %}
<section class="card narrow">
  <h1>Your recovery codes</h1>
  {% block intro %}<p class="muted">If you lose your phone, each of these codes lets you sign in once. Save them somewhere safe, such as a password manager. They are shown only now.</p>{% endblock %}
  <ul class="codes">{% for code in codes %}<li>{{ code }}</li>{% endfor %}</ul>
  {% if continue_action %}
    <form method="post" action="{{ continue_action }}">
      <input type="hidden" name="_csrf" value="{{ csrf }}">
      <button class="btn block">I have saved them, continue</button>
    </form>
  {% else %}
    <a class="btn block" href="{{ continue_href }}">I have saved them</a>
  {% endif %}
</section>
{% endblock %}
