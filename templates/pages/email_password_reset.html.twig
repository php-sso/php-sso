{% extends '_email.html.twig' %}
{% block email_body %}
<p style="margin:0 0 14px;">Hello {{ user.name }},</p>
<p style="margin:0 0 14px;">{% if by_admin %}An administrator of {{ app_name }} sent you this link so that you can choose a new password for your account (<strong>{{ user.username }}</strong>).{% else %}Someone asked to choose a new password for your {{ app_name }} account (<strong>{{ user.username }}</strong>).{% endif %} To do that, use the button within {{ minutes }} minutes.</p>
<p style="margin:0 0 18px;"><a href="{{ link }}" style="display:inline-block;background:#0f6b7a;color:#ffffff;text-decoration:none;font-weight:600;padding:10px 18px;border-radius:6px;">Choose a new password</a></p>
<p style="margin:0 0 14px;font-size:13px;color:#4b5563;">Or copy this address into your browser:<br><span style="word-break:break-all;">{{ link }}</span></p>
<p style="margin:0;font-size:13px;color:#4b5563;">The link works once.{% if not by_admin %} If you did not ask for this, ignore this message: your password has not changed. The request came from {{ ip }}.{% endif %}</p>
{% endblock %}
