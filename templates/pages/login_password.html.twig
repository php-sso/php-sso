{% extends 'layout.html.twig' %}
{% import '_macros.html.twig' as f %}
{% block title %}Sign in{% endblock %}
{% block page_name %}login{% endblock %}
{% block content %}
<section class="card narrow">
  <h1>Sign in</h1>
  {% block intro %}<p class="muted">Signing in as <strong>{{ username }}</strong>. <a href="/login">Not you?</a></p>{% endblock %}
  {% if error %}<div class="notice error" role="alert">{{ error }}</div>{% endif %}
  <form method="post" action="/login/password" novalidate>
    <input type="hidden" name="_csrf" value="{{ csrf }}">
    {{ f.field('password', 'Password', '', '', 'password', 'autocomplete="current-password" autofocus required') }}
    <button class="btn block">Sign in</button>
  </form>
  {% block after_form %}{% if password_reset ?? false %}<a class="btn ghost block" href="/password/forgot">Forgot your password?</a>{% endif %}{% endblock %}
</section>
{% endblock %}
