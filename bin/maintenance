#!/usr/bin/env php
<?php

declare(strict_types=1);

// Housekeeping for the stored data. Run it from cron (for example hourly); it is safe to run at any time.
//   bin/maintenance          drop ended sessions, expired codes and tokens, and old failures

use PhpSso\Store\StorageFactory;
use PhpSso\Store\StorageOptions;

require dirname(__DIR__) . '/vendor/autoload.php';

$config = require dirname(__DIR__) . '/config/config.php';
$storage = StorageFactory::create($config['storage'], new StorageOptions($config['session_idle_seconds'], array_keys($config['scopes'])));
$storage->maintenance()->purgeExpired();
fwrite(STDOUT, "Expired data removed.\n");
